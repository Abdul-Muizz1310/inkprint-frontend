# Backend API (FastAPI on Render). Only server code calls it: the browser goes
# through the same-origin signing proxy /api/backend (docs/specs/04-backend-proxy.md).
NEXT_PUBLIC_API_URL=https://inkprint-backend.onrender.com

# Ed25519 private key, PKCS#8 DER, base64 — SERVER-ONLY, never NEXT_PUBLIC_.
# The proxy and the certificate page sign a 60-second platform token with it
# for every backend call; the backend holds the public half as
# INKPRINT_FRONTEND_SIGNING_KEY_PUBLIC. Unset: the proxy answers 503.
INKPRINT_FRONTEND_SIGNING_KEY_PRIVATE=

# Public site URL.
# - Local dev: http://localhost:3000
# - Production: https://inkprint-frontend.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
